# Origin of the Spring Boot API (no trailing slash).
# Dev: Vite proxies /api to this origin so the browser can call the same-origin /api path.
# Production (Vercel): set this in Project Settings → Environment Variables for Production
# (and Preview if you use it). The build writes vercel.json so /api/* is proxied here
# BEFORE the SPA catch-all rewrite. Example: https://your-api.onrender.com
VITE_API_ORIGIN=http://localhost:8080
