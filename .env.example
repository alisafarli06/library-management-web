# Origin of the Spring Boot API (no trailing slash).
# Local `npm run dev` always proxies /api to http://localhost:8080, even if this
# value is a production Render URL. Production builds (`vite build` / Vercel)
# call VITE_API_ORIGIN directly.
# Local example: http://localhost:8080
# Vercel Production example: https://your-api.onrender.com
VITE_API_ORIGIN=http://localhost:8080

# Render (backend, not Vercel): set FRONTEND_ORIGIN to this frontend's origin.
# Example: FRONTEND_ORIGIN=https://your-app.vercel.app

