# Origin of the Spring Boot API (no trailing slash).
# Dev: Vite proxies /api to this origin so the browser can call the same-origin /api path.
# Production (Vercel): set in Project Settings → Environment Variables for Production.
# The production build calls this URL directly and also writes an /api proxy in vercel.json.
# Example: https://your-api.onrender.com
VITE_API_ORIGIN=http://localhost:8080

# Render (backend, not Vercel): browser origin of this frontend for CORS.
# Example: FRONTEND_ORIGIN=https://your-app.vercel.app
# CORS_ALLOWED_ORIGINS can be used as a comma-separated fallback.
